{
  "name": "sidekick",
  "description": "Side panel with your favorite websites and notes",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare",
    "test:coverage": "vitest run --coverage",
    "icons": "tsx scripts/generate-icons.ts",
    "lint:firefox": "web-ext lint -s .output/firefox-mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm build:firefox"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.7",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
